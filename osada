      ctx.lineTo(ox + s * .8, Y + s * .4); ctx.lineTo(ox + s * .88, Y + s * .82); ctx.closePath(); ctx.fill();
      ctx.fillStyle = "#a9b8c6"; ctx.beginPath();
      ctx.moveTo(ox + s * .26, Y + s * .44); ctx.lineTo(ox + s * .5, Y + s * .28); ctx.lineTo(ox + s * .56, Y + s * .5); ctx.lineTo(ox + s * .32, Y + s * .58); ctx.closePath(); ctx.fill();
      dmg(i, v, X, Y);
    } else if (v === T.STUMP) {
      ctx.fillStyle = "#6b4a2b"; ctx.fillRect(X + s * .38, Y + s * .62, s * .24, s * .16);
      ctx.fillStyle = "#c79a62"; ctx.beginPath(); ctx.ellipse(X + s / 2, Y + s * .62, s * .12, s * .05, 0, 0, 7); ctx.fill();
    } else if (v === T.RUBBLE) {
      ctx.fillStyle = "#8d98a3";
      ctx.fillRect(X + s * .3, Y + s * .66, s * .12, s * .09); ctx.fillRect(X + s * .52, Y + s * .7, s * .16, s * .1); ctx.fillRect(X + s * .44, Y + s * .58, s * .08, s * .07);
    } else if (v === T.HUT) {
      ctx.fillStyle = "rgba(0,0,0,.2)"; ctx.fillRect(X + s * .12, Y + s * .84, s * .8, s * .08);
      ctx.fillStyle = "#a8743f"; ctx.fillRect(X + s * .16, Y + s * .44, s * .68, s * .42);
      ctx.fillStyle = "#8a5d31"; for (let k = 0; k < 3; k++) ctx.fillRect(X + s * .16, Y + s * (.52 + k * .12), s * .68, 2);
      ctx.fillStyle = "#c2523f"; ctx.beginPath(); ctx.moveTo(X + s * .06, Y + s * .48); ctx.lineTo(X + s / 2, Y + s * .1); ctx.lineTo(X + s * .94, Y + s * .48); ctx.closePath(); ctx.fill();
      ctx.fillStyle = "#4a2f1a"; ctx.fillRect(X + s * .42, Y + s * .62, s * .16, s * .24);
    } else if (v === T.HOUSE) {
      ctx.fillStyle = "rgba(0,0,0,.2)"; ctx.fillRect(X + s * .08, Y + s * .86, s * .86, s * .08);
      ctx.fillStyle = "#6d6d73"; ctx.fillRect(X + s * .66, Y + s * .08, s * .1, s * .24);
      ctx.fillStyle = "#b5bcc4"; ctx.fillRect(X + s * .12, Y + s * .4, s * .76, s * .48);
      ctx.fillStyle = "#97a0aa"; for (let k = 0; k < 4; k++) for (let m = 0; m < 3; m++) ctx.fillRect(X + s * (.14 + m * .25 + (k % 2) * .12), Y + s * (.44 + k * .11), s * .1, 2);
      ctx.fillStyle = "#3e4a5c"; ctx.beginPath(); ctx.moveTo(X + s * .04, Y + s * .44); ctx.lineTo(X + s / 2, Y + s * .06); ctx.lineTo(X + s * .96, Y + s * .44); ctx.closePath(); ctx.fill();
      ctx.fillStyle = "#f4cf6a"; ctx.fillRect(X + s * .2, Y + s * .54, s * .14, s * .12); ctx.fillRect(X + s * .66, Y + s * .54, s * .14, s * .12);
      ctx.fillStyle = "#3b2a1c"; ctx.fillRect(X + s * .43, Y + s * .64, s * .14, s * .24);
      const sm = (t * .6) % 1; ctx.fillStyle = `rgba(230,230,230,${.5 - sm * .5})`; ctx.beginPath(); ctx.arc(X + s * .71, Y + s * (.05 - sm * .2), s * (.05 + sm * .06), 0, 7); ctx.fill();
    }
  }
  function dmg(i, v, X, Y) {
    if (!S.hp[i]) return;
    const s = tile, frac = 1 - S.hp[i] / hitsFor(v);
    ctx.fillStyle = "#0b120e"; ctx.fillRect(X + s * .15, Y + s * .02, s * .7, 5);
    ctx.fillStyle = v === T.TREE ? "#e0a45a" : "#a9b8c6"; ctx.fillRect(X + s * .15 + 1, Y + s * .02 + 1, (s * .7 - 2) * frac, 3);
  }
  function drawPerson(p, t, s, ox, oy) {
    const X = ox + p.fx * s, Y = oy + p.fy * s;
    const bob = p.moving ? Math.abs(Math.sin(t * 14)) * s * .05 : 0, by = Y - bob;
    ctx.fillStyle = "rgba(0,0,0,.25)"; ctx.beginPath(); ctx.ellipse(X + s / 2, Y + s * .88, s * .2, s * .07, 0, 0, 7); ctx.fill();
    ctx.fillStyle = "#2b3a6b"; ctx.fillRect(X + s * .38, by + s * .7, s * .09, s * .16); ctx.fillRect(X + s * .53, by + s * .7, s * .09, s * .16);
    ctx.fillStyle = p.c; ctx.fillRect(X + s * .34, by + s * .45, s * .32, s * .28);
    ctx.fillStyle = "#f1c49b"; ctx.fillRect(X + s * .37, by + s * .24, s * .26, s * .22);
    ctx.fillStyle = "#1b1b1b"; ctx.fillRect(X + s * (p.dir > 0 ? .54 : .41), by + s * .32, 3, 3);
    ctx.fillStyle = "#e8b64c"; ctx.fillRect(X + s * .3, by + s * .2, s * .4, s * .07); ctx.fillRect(X + s * .38, by + s * .12, s * .24, s * .1);
    ctx.save();
    ctx.translate(X + s * (p.dir > 0 ? .68 : .32), by + s * .55);
    ctx.rotate((p.swing > 0 ? -1.4 + (.2 - p.swing) * 9 : -.5) * p.dir);
    ctx.fillStyle = "#7a5230"; ctx.fillRect(-1.5, -s * .32, 3, s * .32);
    ctx.fillStyle = "#c9d2da"; ctx.fillRect(p.dir > 0 ? 0 : -s * .12, -s * .34, s * .12, s * .09);
    ctx.restore();
  }

  // ---------- world map ----------
  const MINI = { [T.GRASS]: "#5d9e3f", [T.TREE]: "#2f6b2c", [T.ROCK]: "#8d98a3", [T.WATER]: "#3b7fb0", [T.BRIDGE]: "#a8743f",
    [T.HUT]: "#e8574a", [T.HOUSE]: "#e8574a", [T.STUMP]: "#6a9a45", [T.RUBBLE]: "#7aa252" };
  function drawMini() {
    const mm = $("mm"), m = mm.getContext("2d"), k = mm.width / W;
    for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) { m.fillStyle = MINI[eff(y * W + x)]; m.fillRect(x * k, y * k, k, k); }
    for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) { // make homes easier to spot
      const v = eff(y * W + x);
      if (isHome(v)) { m.fillStyle = myHome(y * W + x) ? "#8fd16a" : "#e8574a"; m.fillRect(x * k - 1, y * k - 1, k + 2, k + 2); }
    }
    for (const o of Object.values(others)) { if (o.inside) continue; m.fillStyle = "#ffffff"; m.fillRect(o.x * k - 2, o.y * k - 2, 5, 5); }
    if (mode === "play") { m.fillStyle = "#0b120e"; m.fillRect(P.x * k - 4, P.y * k - 4, 9, 9); m.fillStyle = "#8fd16a"; m.fillRect(P.x * k - 3, P.y * k - 3, 7, 7); }
  }
  function openMap(kind) {
    const spawn = kind === "spawn";
    $("mapEyebrow").textContent = spawn ? "Krok 2 ze 2" : "Svět osady";
    $("mapTitle").textContent = spawn ? "Ťukni na mapu, kde začneš" : (mode === "play" ? "Tady jsi ty, zelený čtvereček" : "Bílé tečky jsou hráči");
    $("bedSpawn").hidden = !(spawn && myHome(me.bed));
    $("randSpawn").hidden = !spawn; $("mapClose").hidden = spawn;
    $("mapView").hidden = false; $("mapView").dataset.kind = kind; drawMini();
  }

  // ---------- UI ----------
  function banner(msg, ms = 2400) {
    const b = $("banner"); b.textContent = msg; b.hidden = false; clearTimeout(bannerT);
    if (ms) bannerT = setTimeout(() => { b.hidden = true; }, ms);
  }
  function renderTop(rows) {
    const ol = $("top"); ol.innerHTML = "";
    for (const r of rows) {
      const li = document.createElement("li"); if (r.id === me.id) li.className = "me";
      li.textContent = r.n; const sp = document.createElement("span"); sp.textContent = r.p; li.append(sp); ol.append(li);
    }
    $("topEmpty").hidden = rows.length > 0;
  }
  function ui() {
    $("sWood").textContent = me.wood; $("sStone").textContent = me.stone; $("sScore").textContent = me.pts;
    const tc = TOOL_COST[me.toolLvl];
    $("toolCost").textContent = tc ? `${tc.wood} dřeva · ${tc.stone} kamene` : "Maximum";
    const play = mode === "play";
    $("trayOut").hidden = !!room; $("trayIn").hidden = !room;
    $("board").hidden = !!room;
    $("mapBtn").hidden = !(play || mode === "watch") || !!room;
    $("bTool").disabled = !play || !tc; $("bHut").disabled = $("bHouse").disabled = !play;
    for (const [id, k] of [["bHut", "hut"], ["bHouse", "house"], ["fBed", "bed"], ["fTable", "table"], ["fFire", "fire"]]) $(id).setAttribute("aria-pressed", selected === k);
  }
  function pick(k) {
    selected = selected === k ? null : k; ui();
    if (!selected) return;
    const item = BUILD[k] || FURN[k];
    banner(BUILD[k] ? `Ťukni na trávu, kde má stát ${item.name.toLowerCase()}` : `Ťukni na podlahu, kam dáš ${item.name.toLowerCase()}`);
  }

  async function sha(text) {
    const buf = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(text));
    return [...new Uint8Array(buf)].map((b) => b.toString(16).padStart(2, "0")).join("");
  }
  async function enter() {
    const nick = $("nick").value.trim().replace(/\s+/g, " ").slice(0, 16);
    const code = $("code").value.trim().toUpperCase();
    if (nick.length < 2) { $("err").textContent = "Napiš přezdívku, aspoň 2 znaky."; return; }
    let ok = store.get("osada-code") === CODE_HASH && !code;
    if (!ok) {
      if (!code) { $("err").textContent = "Napiš kód, který najdeš na Instagramu."; return; }
      try { ok = (await sha(code)) === CODE_HASH; } catch (e) { $("err").textContent = "Tenhle prohlížeč neumí kód ověřit. Zkus jiný."; return; }
      if (!ok) { $("err").textContent = "Tenhle kód neplatí. Aktuální je v posledním příběhu na Instagramu."; return; }
      store.set("osada-code", CODE_HASH);
    }
    me.name = nick; saveMe(); $("err").textContent = "";
    $("gate").hidden = true; mode = "spawn"; openMap("spawn");
  }
  function spawnAt(x, y, homeIndex) {
    $("mapView").hidden = true; mode = "play";
    const [sx, sy] = freeNear(x, y);
    P.x = sx; P.y = sy; P.fx = sx; P.fy = sy; P.path = []; P.job = null;
    camX = sx * tile; camY = sy * tile;
    if (online) {
      myRef = db.ref("players/" + me.id);
      myRef.onDisconnect().remove();
      myRef.set({ n: me.name, c: me.c, x: P.x, y: P.y, ts: TS() });
      if (me.pts > 0) saveScore();
    }
    if (homeIndex !== undefined) enterHouse(homeIndex);
    else banner(online ? "Ťukni na strom nebo kámen. Domy, které postavíš, uvidí všichni." : "Offline zkouška: hra ještě není propojená s Firebase, ostatní hráče neuvidíš.", 4500);
    ui();
  }
  function watch() {
    mode = "watch"; $("gate").hidden = true; ui();
    const n = Object.values(others).filter((o) => !o.inside).length;
    banner(n ? "Díváš se. Ťuknutím přepneš na jiného hráče." : "Teď nikdo venku nehraje. Na mapě uvidíš celý svět.", 0);
  }

  // ---------- input ----------
  cv.addEventListener("pointerdown", (e) => {
    if (mode === "watch") { followIdx++; return; }
    if (mode !== "play") return;
    const r = cv.getBoundingClientRect(), px = e.clientX - r.left, py = e.clientY - r.top;
    if (room) {
      const { s, ox, oy } = roomView, x = Math.floor((px - ox) / s), y = Math.floor((py - oy) / s);
      if (x >= 0 && y >= 0 && x < room.w && y < room.h) order(x, y);
      return;
    }
    const x = Math.floor((px + camX) / tile), y = Math.floor((py + camY) / tile);
    if (x >= 0 && y >= 0 && x < W && y < H) order(x, y);
  });
  $("mm").addEventListener("pointerdown", (e) => {
    if ($("mapView").dataset.kind !== "spawn") return;
    const r = $("mm").getBoundingClientRect();
    spawnAt(Math.floor((e.clientX - r.left) / r.width * W), Math.floor((e.clientY - r.top) / r.height * H));
  });
  window.addEventListener("keydown", (e) => {
    if (mode !== "play" || e.target.tagName === "INPUT") return;
    const d = { ArrowUp: [0,-1], ArrowDown: [0,1], ArrowLeft: [-1,0], ArrowRight: [1,0], w: [0,-1], s: [0,1], a: [-1,0], d: [1,0] }[e.key];
    if (d) { e.preventDefault(); order(P.x + d[0], P.y + d[1]); }
    if (e.key === "Escape") { selected = null; ui(); }
  });
  $("go").addEventListener("click", enter);
  $("code").addEventListener("keydown", (e) => { if (e.key === "Enter") enter(); });
  $("watch").addEventListener("click", watch);
  $("bHut").addEventListener("click", () => pick("hut"));
  $("bHouse").addEventListener("click", () => pick("house"));
  $("bTool").addEventListener("click", buyTool);
  $("fBed").addEventListener("click", () => pick("bed"));
  $("fTable").addEventListener("click", () => pick("table"));
  $("fFire").addEventListener("click", () => pick("fire"));
  $("fExit").addEventListener("click", () => { if (room) { selected = null; const p = pathTo(room.door[0], room.door[1], false); if (p) { P.path = p; P.job = { kind: "exit" }; } ui(); } });
  $("mapBtn").addEventListener("click", () => openMap("view"));
  $("mapClose").addEventListener("click", () => { $("mapView").hidden = true; });
  $("randSpawn").addEventListener("click", () => spawnAt(10 + Math.floor(Math.random() * (W - 20)), 10 + Math.floor(Math.random() * (H - 20))));
  $("bedSpawn").addEventListener("click", () => { const i = me.bed; spawnAt(i % W, Math.floor(i / W), i); });
  $("board").addEventListener("click", () => $("board").classList.toggle("min"));
  window.addEventListener("resize", resize);

  // ---------- boot ----------
  if (me.name) $("nick").value = me.name;
  if (store.get("osada-code") === CODE_HASH) $("code").placeholder = "Kód máš uložený";
  resize(); ui();
  let last = performance.now();
  function loop(t) { const dt = Math.min(.05, (t - last) / 1000); last = t; update(dt); draw(t); requestAnimationFrame(loop); }
  requestAnimationFrame(loop);
})();
</script>
</body>
</html>
