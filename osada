<!doctype html>
<html lang="cs">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Osada</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@500;700&family=Atkinson+Hyperlegible:wght@400;700&display=swap">
<style>
/* Layout: one-screen game. HUD on top, shared map in the middle, build tray at the bottom. */
:root {
  --frame: #15201a; --frame-2: #1f2e25; --line: #34493c;
  --ink: #eef3e6; --muted: #9fb3a3; --wood: #e0a45a; --stone: #a9b8c6; --moss: #8fd16a; --danger: #ff8a6b;
  --display: "Pixelify Sans", "Courier New", monospace;
  --body: "Atkinson Hyperlegible", system-ui, -apple-system, "Segoe UI", sans-serif;
  color-scheme: dark;
}
* { box-sizing: border-box; }
html, body { height: 100%; margin: 0; }
body {
  background: var(--frame); color: var(--ink); font-family: var(--body); font-size: 15px;
  overflow: hidden; -webkit-tap-highlight-color: transparent; touch-action: manipulation;
  padding-top: env(safe-area-inset-top, 0px); padding-bottom: env(safe-area-inset-bottom, 0px);
}
[hidden] { display: none !important; }
#app { height: 100%; display: flex; flex-direction: column; }
.hud, .tray {
  display: flex; align-items: center; gap: 10px;
  padding-block: 10px;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
  background: var(--frame-2);
}
.hud { border-bottom: 2px solid var(--line); flex-wrap: wrap; }
.tray { border-top: 2px solid var(--line); overflow-x: auto; }
.brand { font-family: var(--display); font-weight: 700; font-size: 22px; color: var(--moss); margin-right: auto; }
.stat { display: flex; align-items: center; gap: 6px; font-family: var(--display); font-size: 18px; font-variant-numeric: tabular-nums; }
.stat i { width: 14px; height: 14px; display: inline-block; border-radius: 3px; }
.stat .w { background: var(--wood); }
.stat .s { background: var(--stone); border-radius: 50%; }
.stat .h { background: #d65a4a; clip-path: polygon(50% 0, 100% 50%, 85% 50%, 85% 100%, 15% 100%, 15% 50%, 0 50%); border-radius: 0; }
.stat .o { background: var(--moss); border-radius: 50%; width: 10px; height: 10px; box-shadow: 0 0 0 3px rgba(143,209,106,.25); }
.mapbtn {
  font-family: var(--display); font-size: 15px; font-weight: 700; color: var(--ink);
  background: var(--frame); border: 2px solid var(--line); border-radius: 6px; padding: 4px 10px; cursor: pointer;
}
.stage { position: relative; flex: 1; min-height: 0; }
#cv { display: block; width: 100%; height: 100%; cursor: pointer; }
.tool {
  flex: 1 0 auto; min-width: 96px; display: flex; flex-direction: column; align-items: flex-start; gap: 2px;
  padding: 8px 10px; background: var(--frame); color: var(--ink);
  border: 2px solid var(--line); border-radius: 6px; font-family: var(--body); font-size: 13px; text-align: left; cursor: pointer;
}
.tool b { font-family: var(--display); font-size: 16px; }
.tool span { color: var(--muted); font-variant-numeric: tabular-nums; }
.tool[aria-pressed="true"] { border-color: var(--moss); box-shadow: inset 0 0 0 1px var(--moss); }
.tool:disabled { opacity: .45; cursor: not-allowed; }
button:focus-visible, input:focus-visible { outline: 3px solid var(--moss); outline-offset: 2px; }
.banner {
  position: absolute; left: 50%; bottom: 12px; transform: translateX(-50%); max-width: calc(100% - 32px);
  background: rgba(21,32,26,.9); border: 2px solid var(--line); border-radius: 6px;
  padding: 6px 12px; font-size: 13px; color: var(--muted); text-align: center; pointer-events: none;
}
.board {
  position: absolute; top: 10px; right: max(10px, env(safe-area-inset-right, 0px)); width: 168px; cursor: pointer;
  background: rgba(21,32,26,.88); border: 2px solid var(--line); border-radius: 8px; padding: 8px 10px; font-size: 13px;
}
.board h3 { margin: 0 0 6px; font-family: var(--display); font-size: 14px; color: var(--wood); letter-spacing: .04em; }
.board ol { margin: 0; padding-left: 18px; display: grid; gap: 2px; }
.board li { font-variant-numeric: tabular-nums; }
.board li span { float: right; color: var(--muted); }
.board li.me { color: var(--moss); }
.board .empty { color: var(--muted); }
.board.min ol, .board.min .empty { display: none; }
.board.min h3 { margin: 0; }
.overlay {
  position: absolute; inset: 0; display: grid; place-items: center; overflow-y: auto;
  padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); padding-block: 16px;
  background: rgba(13,20,16,.78);
}
.card {
  width: 100%; max-width: 380px; background: var(--frame-2); border: 2px solid var(--line); border-radius: 10px;
  padding: 22px 20px; display: flex; flex-direction: column; gap: 12px; box-shadow: 0 6px 0 #0b120e;
}
.card h1 { margin: 0; font-family: var(--display); font-size: 44px; color: var(--moss); line-height: 1; }
.card h2 { margin: 0; font-family: var(--display); font-size: 26px; text-wrap: balance; }
.card p { margin: 0; color: var(--muted); line-height: 1.5; }
.eyebrow { font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--wood); font-weight: 700; }
label.eyebrow { color: var(--muted); margin-bottom: -6px; }
.card input {
  width: 100%; padding: 12px; font-size: 18px; font-family: var(--display);
  background: var(--frame); color: var(--ink); border: 2px solid var(--line); border-radius: 6px;
}
#code { text-transform: uppercase; letter-spacing: .08em; }
.btn {
  padding: 12px 16px; font-family: var(--display); font-size: 18px; font-weight: 700;
  background: var(--moss); color: #10200f; border: 0; border-radius: 6px; cursor: pointer; box-shadow: 0 3px 0 #4f8a35;
}
.btn:active { transform: translateY(2px); box-shadow: 0 1px 0 #4f8a35; }
.btn.ghost { background: transparent; color: var(--ink); border: 2px solid var(--line); box-shadow: none; }
.err { color: var(--danger); font-size: 14px; min-height: 1.2em; }
.mapcard { max-width: 460px; }
#mm { width: 100%; max-width: 100%; aspect-ratio: 1; image-rendering: pixelated; border: 2px solid var(--line); border-radius: 6px; cursor: crosshair; display: block; }
.legend { display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: 12px; color: var(--muted); }
.legend i { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 5px; vertical-align: -1px; }
.btnrow { display: flex; gap: 8px; flex-wrap: wrap; }
.btnrow .btn { flex: 1 1 140px; font-size: 16px; }
@media (prefers-reduced-motion: reduce) { .btn:active { transform: none; } }
</style>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>
</head>
<body>
<div id="app">
  <header class="hud">
    <div class="brand">Osada</div>
    <div class="stat" title="Dřevo"><i class="w"></i><span id="sWood">0</span></div>
    <div class="stat" title="Kámen"><i class="s"></i><span id="sStone">0</span></div>
    <div class="stat" title="Tvoje body"><i class="h"></i><span id="sScore">0</span></div>
    <div class="stat" title="Hráčů online"><i class="o"></i><span id="sOnline">0</span></div>
    <button class="mapbtn" id="mapBtn" hidden>Mapa</button>
  </header>

  <main class="stage">
    <canvas id="cv" aria-label="Společná mapa osady"></canvas>
    <aside class="board" id="board">
      <h3>Nejlepší stavitelé</h3>
      <ol id="top"></ol>
      <div class="empty" id="topEmpty">Zatím nikdo nic nepostavil</div>
    </aside>
    <div class="banner" id="banner" hidden></div>

    <section class="overlay" id="gate">
      <div class="card">
        <div class="eyebrow">Společná hra pro sledující</div>
        <h1>Osada</h1>
        <p>Kácej stromy, těž kámen, stav domy a zařiď si je. Všichni hrají v jednom velkém světě.</p>
        <label class="eyebrow" for="nick">Přezdívka</label>
        <input id="nick" maxlength="16" autocomplete="nickname" placeholder="třeba tvůj Instagram">
        <label class="eyebrow" for="code">Kód z Instagramu</label>
        <input id="code" maxlength="24" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="KÓD">
        <div class="err" id="err" role="status"></div>
        <button class="btn" id="go">Pokračovat</button>
        <button class="btn ghost" id="watch">Jen se dívat</button>
      </div>
    </section>

    <section class="overlay" id="mapView" hidden>
      <div class="card mapcard">
        <div class="eyebrow" id="mapEyebrow">Krok 2 ze 2</div>
        <h2 id="mapTitle">Ťukni na mapu, kde začneš</h2>
        <canvas id="mm" width="240" height="240" aria-label="Mapa celého světa"></canvas>
        <div class="legend">
          <span><i style="background:#2f6b2c"></i>les</span><span><i style="background:#8d98a3"></i>kámen</span>
          <span><i style="background:#3b7fb0"></i>voda</span><span><i style="background:#a8743f"></i>most</span>
          <span><i style="background:#e8574a"></i>domy</span><span><i style="background:#ffffff"></i>hráči</span><span><i style="background:#8fd16a"></i>ty</span>
        </div>
        <div class="btnrow">
          <button class="btn" id="bedSpawn" hidden>Začít u své postele</button>
          <button class="btn ghost" id="randSpawn">Náhodné místo</button>
          <button class="btn ghost" id="mapClose" hidden>Zavřít mapu</button>
        </div>
      </div>
    </section>
  </main>

  <nav class="tray" id="trayOut">
    <button class="tool" id="bHut" aria-pressed="false" disabled><b>Chatka</b><span>10 dřeva · 4 kamene</span></button>
    <button class="tool" id="bHouse" aria-pressed="false" disabled><b>Kamenný dům</b><span>6 dřeva · 14 kamene</span></button>
    <button class="tool" id="bTool" disabled><b>Lepší nástroje</b><span id="toolCost">8 dřeva · 6 kamene</span></button>
  </nav>
  <nav class="tray" id="trayIn" hidden>
    <button class="tool" id="fBed" aria-pressed="false"><b>Postel</b><span>8 dřeva</span></button>
    <button class="tool" id="fTable" aria-pressed="false"><b>Stůl</b><span>5 dřeva</span></button>
    <button class="tool" id="fFire" aria-pressed="false"><b>Krb</b><span>10 kamene</span></button>
    <button class="tool" id="fExit"><b>Ven</b><span>Odejít z domu</span></button>
  </nav>
</div>

<script>
// ======================= NASTAVENÍ =======================
// 1) Nastavení Firebase projektu "manazinie".
const FIREBASE_CONFIG = {
  apiKey: "AIzaSyBhe7RX5LSEsVCkyAfWl2Fd2y8LnQbQlWk",
  authDomain: "manazinie.firebaseapp.com",
  databaseURL: "https://manazinie-default-rtdb.europe-west1.firebasedatabase.app",
  projectId: "manazinie",
  storageBucket: "manazinie.firebasestorage.app",
  messagingSenderId: "448691563099",
  appId: "1:448691563099:web:ef9a1a2f02f324a7f46d7e",
};
// 2) Kód do hry: SHA-256 kódu psaného VELKÝMI písmeny. Teď je to SEKERA.
const CODE_HASH = "b450d021dbddedaf805c6f125465e385dd3d82de6bd319afc002b56313b48c2c";
// =========================================================

(() => {
  const W = 120, H = 120, SEED = 2026;
  const T = { GRASS: 0, TREE: 1, ROCK: 2, WATER: 3, HUT: 4, HOUSE: 5, STUMP: 6, RUBBLE: 7, BRIDGE: 8 };
  const BUILD = {
    hut:   { tile: T.HUT,   wood: 10, stone: 4,  pts: 100, name: "Chatka" },
    house: { tile: T.HOUSE, wood: 6,  stone: 14, pts: 300, name: "Kamenný dům" },
  };
  const FURN = {
    bed:   { id: 1, wood: 8, stone: 0,  pts: 20, name: "Postel" },
    table: { id: 2, wood: 5, stone: 0,  pts: 10, name: "Stůl" },
    fire:  { id: 3, wood: 0, stone: 10, pts: 30, name: "Krb" },
  };
  const TOOL_COST = [{ wood: 8, stone: 6 }, { wood: 16, stone: 14 }];
  const SHIRTS = ["#d9533f", "#3f7fd9", "#9b4fd1", "#e0a020", "#2fae8e", "#e26aa8", "#6b8f23", "#e86f2c"];

  const $ = (id) => document.getElementById(id);
  let bannerT;
  const cv = $("cv"), ctx = cv.getContext("2d");
  const store = {
    get(k) { try { return localStorage.getItem(k); } catch (e) { return null; } },
    set(k, v) { try { localStorage.setItem(k, v); } catch (e) {} },
  };

  // ---------- shared world ----------
  // The base map is the same for everyone (fixed seed). Only changes are stored online.
  function rng(seed) { let s = seed >>> 0; return () => { s = (s * 1664525 + 1013904223) >>> 0; return s / 4294967296; }; }
  const base = (() => {
    const r = rng(SEED), m = new Array(W * H).fill(T.GRASS);
    for (let k = 0; k < 14; k++) {
      const px = Math.floor(r() * W), py = Math.floor(r() * H), rad = 2.2 + r() * 3.5;
      for (let y = Math.max(0, py - 8); y < Math.min(H, py + 8); y++) for (let x = Math.max(0, px - 8); x < Math.min(W, px + 8); x++)
        if (Math.hypot((x - px) * 1.2, y - py) < rad) m[y * W + x] = T.WATER;
    }
    const scatter = (type, clusters, n, spread) => {
      for (let c = 0; c < clusters; c++) {
        const cx = Math.floor(r() * W), cy = Math.floor(r() * H);
        for (let i = 0; i < n; i++) {
          const x = Math.round(cx + (r() - .5) * spread), y = Math.round(cy + (r() - .5) * spread);
          if (x >= 0 && y >= 0 && x < W && y < H && m[y * W + x] === T.GRASS) m[y * W + x] = type;
        }
      }
    };
    scatter(T.TREE, 150, 22, 9); scatter(T.ROCK, 80, 11, 6);
    // a river from north to south with bridges
    for (let y = 0; y < H; y++) {
      const cx = Math.round(W * .55 + Math.sin(y / 11) * 14 + Math.sin(y / 4.3) * 2);
      for (let x = cx - 1; x <= cx + 1; x++) m[y * W + x] = (y % 17 === 8) ? T.BRIDGE : T.WATER;
    }
    return m;
  })();
  let tiles = {};          // index -> {t, r (regrow at, server ms), o (builder name), oid (builder id)}
  let offset = 0;
  const now = () => Date.now() + offset;
  function effFrom(o, i) { if (!o) return base[i]; if (o.r && now() > o.r) return base[i]; return o.t; }
  const eff = (i) => effFrom(tiles[i], i);
  const at = (x, y) => (x < 0 || y < 0 || x >= W || y >= H) ? T.WATER : eff(y * W + x);
  const walkable = (t) => t === T.GRASS || t === T.STUMP || t === T.RUBBLE || t === T.BRIDGE;
  const isHome = (t) => t === T.HUT || t === T.HOUSE;

  // ---------- me ----------
  let me = null;
  try { me = JSON.parse(store.get("osada-me") || "null"); } catch (e) {}
  if (!me || !me.id) me = { id: "p" + Math.random().toString(36).slice(2, 10), name: "", wood: 0, stone: 0, toolLvl: 0, pts: 0, c: SHIRTS[Math.floor(Math.random() * SHIRTS.length)] };
  if (me.bed === undefined) me.bed = null;
  const saveMe = () => store.set("osada-me", JSON.stringify(me));
  const hitsFor = (t) => Math.max(1, (t === T.TREE ? 3 : 4) - me.toolLvl);
  const myHome = (i) => i !== null && i !== undefined && isHome(eff(i)) && tiles[i] && tiles[i].oid === me.id;

  const S = { hp: {}, fx: [], marker: null };
  const P = { x: 60, y: 60, fx: 60, fy: 60, path: [], job: null, cd: 0, swing: 0, dir: 1 };
  let room = null;         // when inside: {i, w, h, items, door:[x,y]}
  let homesLocal = {};     // offline storage of furniture
  let homeRef = null;
  let others = {};
  let mode = "idle";       // idle | spawn | play | watch
  let selected = null, followIdx = 0;
  let tile = 32, camX = 60 * 32, camY = 60 * 32, dpr = 1;

  // ---------- network ----------
  const online = typeof firebase !== "undefined" && !String(FIREBASE_CONFIG.apiKey).startsWith("DOPLN");
  let db = null, myRef = null;
  if (online) {
    firebase.initializeApp(FIREBASE_CONFIG);
    db = firebase.database();
    db.ref(".info/serverTimeOffset").on("value", (s) => { offset = s.val() || 0; });
    db.ref("world/tiles").on("value", (s) => { tiles = s.val() || {}; if (!$("mapView").hidden) drawMini(); });
    db.ref("players").on("value", (s) => {
      const v = s.val() || {}, next = {};
      for (const [id, p] of Object.entries(v)) {
        if (id === me.id || !p || typeof p.x !== "number" || now() - (p.ts || 0) > 120000) continue;
        const old = others[id];
        next[id] = { n: String(p.n || "Hráč").slice(0, 16), x: p.x, y: p.y, c: SHIRTS.includes(p.c) ? p.c : SHIRTS[0], act: p.a || 0,
          inside: typeof p.in === "number", fx: old ? old.fx : p.x, fy: old ? old.fy : p.y, dir: old ? old.dir : 1, swing: 0 };
      }
      others = next; $("sOnline").textContent = Object.keys(others).length + (mode === "play" ? 1 : 0);
    });
    db.ref("scores").orderByChild("p").limitToLast(5).on("value", (s) => {
      const rows = []; s.forEach((c) => { const v = c.val(); if (v && v.p > 0) rows.push({ id: c.key, n: String(v.n || "Hráč").slice(0, 16), p: v.p | 0 }); });
      rows.sort((a, b) => b.p - a.p); renderTop(rows);
    });
  } else {
    try { homesLocal = JSON.parse(store.get("osada-homes") || "{}"); tiles = JSON.parse(store.get("osada-tiles") || "{}"); } catch (e) {}
    renderTop([]);
  }
  const TS = () => online ? firebase.database.ServerValue.TIMESTAMP : Date.now();
  function sendPos(extra) {
    if (!online || mode !== "play") return;
    myRef.update(Object.assign({ x: P.x, y: P.y, ts: TS() }, extra || {}));
  }
  // claim a tile change so only one player gets each tree, rock or building spot
  function claim(i, test, value, done) {
    if (!online) {
      if (test(eff(i))) { tiles[i] = value; store.set("osada-tiles", JSON.stringify(tiles)); done(true); } else done(false);
      return;
    }
    db.ref("world/tiles/" + i).transaction((cur) => test(effFrom(cur, i)) ? value : undefined, (err, ok) => done(!err && ok), false);
  }
  function saveScore() { saveMe(); if (online && me.name) db.ref("scores/" + me.id).set({ n: me.name, p: me.pts }); }

  // ---------- grids & pathfinding ----------
  const outside = { w: W, h: H, walk: (x, y) => walkable(at(x, y)) };
  function roomGrid() {
    return { w: room.w, h: room.h, walk: (x, y) => {
      if (x === room.door[0] && y === room.door[1]) return true;
      return x >= 1 && y >= 1 && x < room.w - 1 && y < room.h - 1 && !room.items[y * room.w + x];
    } };
  }
  const grid = () => room ? roomGrid() : outside;
  function pathTo(tx, ty, adjacent, g = grid()) {
    const sx = P.x, sy = P.y, gw = g.w;
    const goal = (x, y) => adjacent ? (Math.abs(x - tx) + Math.abs(y - ty) === 1) : (x === tx && y === ty);
    if (goal(sx, sy)) return [];
    const prev = new Int32Array(g.w * g.h).fill(-2), q = [sy * gw + sx]; prev[sy * gw + sx] = -1;
    for (let h = 0; h < q.length; h++) {
      const i = q[h], x = i % gw, y = (i / gw) | 0;
      for (const [dx, dy] of [[1,0],[-1,0],[0,1],[0,-1]]) {
        const nx = x + dx, ny = y + dy;
        if (nx < 0 || ny < 0 || nx >= g.w || ny >= g.h) continue;
        const ni = ny * gw + nx;
        if (prev[ni] !== -2 || !g.walk(nx, ny)) continue;
        prev[ni] = i;
        if (goal(nx, ny)) { const out = []; let c = ni; while (c !== sy * gw + sx) { out.unshift([c % gw, (c / gw) | 0]); c = prev[c]; } return out; }
        q.push(ni);
      }
    }
    return null;
  }

  // ---------- actions ----------
  const canAfford = (c) => me.wood >= c.wood && me.stone >= c.stone;
  function order(tx, ty) {
    if (room) return orderInside(tx, ty);
    const t = at(tx, ty), i = ty * W + tx;
    if (selected) {
      const b = BUILD[selected];
      if (!walkable(t) || t === T.BRIDGE || (tx === P.x && ty === P.y)) return banner("Stavět jde jen na volnou trávu");
      if (!canAfford(b)) return banner(`Na ${b.name.toLowerCase()} ti chybí suroviny`);
      const path = pathTo(tx, ty, true); if (!path) return banner("Tam se nedostaneš");
      P.path = path; P.job = { kind: "build", x: tx, y: ty, b: selected, prog: 0 }; S.marker = { x: tx, y: ty }; return;
    }
    if (isHome(t)) {
      if (!myHome(i)) return banner(`Tohle je dům hráče ${(tiles[i] && tiles[i].o) || "neznámého"}`);
      const path = pathTo(tx, ty, true); if (!path) return banner("K domu se nedostaneš");
      P.path = path; P.job = { kind: "enter", x: tx, y: ty }; S.marker = { x: tx, y: ty }; return;
    }
    if (t === T.TREE || t === T.ROCK) {
      const path = pathTo(tx, ty, true); if (!path) return banner("Tam se nedostaneš");
      P.path = path; P.job = { kind: "harvest", x: tx, y: ty }; S.marker = { x: tx, y: ty }; return;
    }
    if (walkable(t)) { const path = pathTo(tx, ty, false); if (path) { P.path = path; P.job = null; S.marker = { x: tx, y: ty }; } }
  }
  function orderInside(tx, ty) {
    const g = roomGrid(), cell = ty * room.w + tx, item = room.items[cell];
    const isDoor = tx === room.door[0] && ty === room.door[1];
